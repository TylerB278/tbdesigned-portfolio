---
const { title } = Astro.props;
import SkipLink from "@components/SkipLink.astro";
import CSSReset from "../global/CSSReset.astro";
import Theme from "../global/Theme.astro";

let fullTitle = title + " | Tyler Boggi"
// This file creates the basic HTML page structure and sets up our CSS reset and theme. We will use this Layout component in all of our pages.
---

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-1KGZLWF82P"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-1KGZLWF82P');
</script>

<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/tyfavicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Encode+Sans:wght@100..900&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Plaster&display=swap" rel="stylesheet">
  <meta name="viewport" content="width=device-width" />
  <title>{fullTitle}</title>
  <CSSReset />
  <Theme />
</head>
<body>
  <SkipLink />
  <!--
  if you are going to use a nav, it should go here, 
  between the skip link and the <main> tag
   -->
  <main id="main-content">
    <slot />
  </main>
  <!--
  if you are going to use a footer, it should go here
   -->
</body>
