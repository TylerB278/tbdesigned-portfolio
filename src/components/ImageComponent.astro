---
import Image from "astro/components/Image.astro";

const { image } = Astro.props;
const { alt } = Astro.props;
const { w } = Astro.props;

---

<Image class="image-component" alt=`${alt}` src={image} style=`width: ${w}`/>

<style>
  .image-component {
    display: flex;
    flex-flow: row wrap;
    /* transition: all 0.2s; */
    padding: 10px;
    margin: 0 auto;
    /* max-width: 400px; */
  } .image-component:hover{ border: 5px solid yellow;}
</style>
