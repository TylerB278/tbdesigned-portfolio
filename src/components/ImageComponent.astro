---
import Image from "astro/components/Image.astro";

const { image } = Astro.props;
const { alt } = Astro.props;
const { w } = Astro.props;

---
<div class="imgFit">
  <Image class="image-component" alt=`${alt}` src={image} style=`width: ${w}`/>
</div>
<style>
  .image-component {
    display: flex;
    flex-flow: row wrap;
    /* transition: all 0.2s; */
    padding: 10px;
    margin: 0 auto;
    transition: all 0.2s;
    /* max-width: 400px; */
  } .image-component:hover{ scale: 103%; }

  @media(max-width: 850px){
    .imgFit{
      height: fit-content;
    }
  }
</style>
