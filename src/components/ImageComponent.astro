---
const { folder } = Astro.props;
const { w } = Astro.props;
const { j } = Astro.props;

---

<img class="image-component" style=`width: ${w}; --just = ${j};` src=`/assets/${folder}`>
</img>

<style>
  .image-component {
    display: flex;
    flex-flow: row wrap;
    /* transition: all 0.2s; */
    padding: 10px;
    margin: 0 auto;
    /* max-width: 400px; */
  } .image-component:hover{ border: 5px solid yellow;}
</style>
