---

const { mw } = Astro.props;

---

<div class="multiCol" style=`max-width: ${mw}`>
    <slot/>
</div>

<style>

.multiCol{
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 15px;
    align-self: center;
    align-items: center;
    overflow-x: hidden;
    margin-top: 30px;
    margin-bottom: 30px;
}

</style>