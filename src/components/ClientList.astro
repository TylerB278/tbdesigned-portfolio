---
import { getImage } from "astro:assets";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const allProjects = await getCollection("clients");
const sortedProjects = allProjects.sort((a,b) => {
    return a.data.order - b.data.order;
})

---
<div class="cardsLayout">
  {
    sortedProjects.map((project) => (
      <div class="projectCardWrap">
        <a href={`/clients/${project.id}/`} class="click"></a>
        <div class={`projectCard backgroundCard`} style={`background-image: url(${project?.data?.thumbnail?.src})`}></div>
        <div class="cardOverlay"></div>  
        <div class="bottomCard">
          <a href={`/clients/${project.id}/`}>
            <h2>{project.data.title}</h2>
            <p>{project.data.projectType}</p>
          </a>
        </div>
      </div>
    ))
  }
</div>

<style>
  .projectCard{
    position: relative;
    display: flex;
    flex-flow: wrap;
    justify-content: flex-start;
    align-items: center;
    overflow: visible;
    width: 500px;
    height: 300px;
    margin: 10px;
    margin-bottom: 0px;
    background-color: var(--color-accent);
    border: 0px solid var(--color-accent);
    transition: all 0.2s;
  }


  .projectCardWrap{
    position: relative;
    width: fit-content;
  }

  .cardOverlay{
    position: absolute;
    background-color: var(--color-accent);
    top: 0px;
    width: 450px;
    height: 300px;
    left: 10px;
    top: 10px;
    transition: all 0.2s;
    z-index: -1;
  }

  .projectCardWrap:hover .cardOverlay,   .projectCardWrap:focus-within .cardOverlay{
    scale: 110%;
    left: 30px;
    top: 0px;
    rotate: 3deg;
  }  
  .projectCardWrap:hover .projectCard,   .projectCardWrap:focus-within .projectCard{
    border: 10px solid var(--color-accent);
    background-size: 105.5%;
    rotate: -5deg;
  }  

  .cardsLayout{
    display: flex;
    justify-content: space-evenly;
    flex-wrap: wrap;
    gap: 30px;
    max-width: 1600px;
    margin: 0 auto;
  }

  @media(min-width: 800px){
  }

  .click{
    position: absolute;
    width: 100%;
    height: 100%;
    text-align: left;
    z-index: 100;
  }

  .bottomCard{
    margin-top: -10px;
    margin-bottom: 0px;
    width: 400px;
  }

  .bottomCard h2{
    color: var(--color-accent);
    width: 500px;
    padding-left: 20px;
    padding-top: 5px;
    text-align: left;
    margin-top: 5px;
    justify-content: flex-start;
  }
  .bottomCard a{ text-decoration: none; }
  .bottomCard p{
    color: var(--color-accent);
    width: 400px;
    padding-left: 20px;
    padding-bottom: 10px;
    margin-top: -8px;
    font-size: 16px;
    text-align: left;
  }

  .bottomCard h2,a:hover{  }

  .backgroundCard{
    background-repeat: none;
    background-position: center;
    background-size: 100%;
  }

  @media(max-width:530px){ 
    .projectCard{
      width: 333.33px;
      height: 200px;
    }
    .cardOverlay{
    width: 280px;
    height: 200px;
    }
    .bottomCard h2{
      font-size: 22px;
      width: 350px;
    } .bottomCard p{ width: 350px; }
    .bottomCard{
      width: 350px;
    }
  }

</style>
