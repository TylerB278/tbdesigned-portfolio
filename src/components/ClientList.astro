---
import { getImage } from "astro:assets";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

//I GIVE UP
//Import Hero Images 
// import Peter from './astro-logo-light-gradient.png';

const allProjects = await getCollection("clients");
// const processedProjects = allProjects.map(async(project)=>{

//   return {...project,imageSrc: await getImage({src: Peter, format: 'png'}) }
// })



---
<div class="cardsLayout">
  {
    allProjects.map((project) => (
      <div class="projectCardWrap">
        <a href={`/clients/${project.id}/`} class="click"></a>
        <div class={`projectCard backgroundCard`} style={`background-image: url(${project?.data?.thumbnail?.src})`}></div>
        <div class="cardOverlay"></div>  
        <div class="bottomCard">
          <a href={`/clients/${project.id}/`}>
            {/* conditional rendering:
            "if project.data.thumbnail exists, then create this <Image> element"
            */}
            {/* {project.data.thumbnail && (
              <Image class="project-img" src={project.data.thumbnail} alt="" />
            )} */}
            <h2>{project.data.title}</h2>
            <p>{project.data.projectType}</p>
          </a>
        </div>
      </div>
    ))
  }
</div>

<style>
  .projectCard{
    position: relative;
    display: flex;
    flex-flow: wrap;
    justify-content: flex-start;
    align-items: center;
    overflow: visible;
    width: 500px;
    height: 300px;
    margin: 10px;
    margin-bottom: 0px;
    background-color: rgb(255, 230, 0);
    border: 0px solid rgba(255, 187, 0);
    transition: all 0.2s;
  }

  /* .projectCard:hover{
    border: 10px solid rgba(255, 187, 0);
    background-size: 105.5%;
    rotate: -5deg;
  } */

  .projectCardWrap{
    position: relative;
    /* border: 5px solid white; */
    width: fit-content;
  }

  .cardOverlay{
    position: absolute;
    background-color: rgba(255, 187, 0);
    top: 0px;
    width: 450px;
    height: 300px;
    left: 10px;
    top: 10px;
    transition: all 0.2s;
    z-index: -1;
  }

  .projectCardWrap:hover .cardOverlay,   .projectCardWrap:focus-within .cardOverlay{
    scale: 110%;
    left: 30px;
    top: 0px;
    rotate: 3deg;
  }  
  .projectCardWrap:hover .projectCard,   .projectCardWrap:focus-within .projectCard{
    border: 10px solid rgba(255, 187, 0);
    background-size: 105.5%;
    rotate: -5deg;
  }  

  .cardsLayout{
    display: flex;
    justify-content: space-evenly;
    flex-wrap: wrap;
    gap: 30px;
  }

  /* .projectCard::before{
  content: "";
  background-color: rgba(255, 187, 0);
  top: 0px;
  width: 500px;
  height: 100%;
  left: 0px;   
  z-index: -100;
  scale: 100%;
  rotate: 0deg;
}
.projectCard:hover::before{ 
  scale: 110%;
  rotate: 15deg;
} */

  @media(min-width: 800px){
  }

  .click{
    position: absolute;
    width: 100%;
    height: 100%;
    z-index: 100;
  }

  .bottomCard{
    margin-top: -10px;
    margin-bottom: 0px;
    width: 400px;
  }

  .bottomCard h2{
    color: yellow;
    width: 500px;
    padding-left: 20px;
    padding-top: 5px;
    text-align: left;
    margin: 0px;
    justify-content: flex-start;
  }
  .bottomCard a{ text-decoration: none; }
  .bottomCard p{
    color: yellow;
    width: 400px;
    padding-left: 20px;
    padding-bottom: 10px;
    margin-top: -8px;
  }

  .bottomCard h2,a:hover{  }

  .backgroundCard{
    background-repeat: none;
    background-position: center;
    background-size: 100%;
  }

  @media(max-width:800px){ 
    .projectCard:after {content: none;} 
    .projectCard{align-self: center;}
    .bottomCard{align-self: center; margin-left: 0px;}
    .click{ position: relative; top: 50%; left: 50%; transform: translate(-50%, -50%);}
  }

</style>
