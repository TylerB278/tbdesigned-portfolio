---
import { getImage } from "astro:assets";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

//I GIVE UP
//Import Hero Images 
// import Peter from './astro-logo-light-gradient.png';

const allProjects = await getCollection("projects");
// const processedProjects = allProjects.map(async(project)=>{

//   return {...project,imageSrc: await getImage({src: Peter, format: 'png'}) }
// })



---

<div class="projectContain">
  {
    allProjects.map((project) => (
      <div class="fullCard">
        <a href={`/projects/${project.id}/`} class="click"></a>
        <div class="projectCard backgroundCard case" style={`background-image: url(${project?.data?.thumbnail?.src})`}></div>
        <div class="bottomCard">
          {/* <a href={`/projects/${project.id}/`}></a> */}
            {/* conditional rendering:
            "if project.data.thumbnail exists, then create this <Image> element"
            */}
            {/* {project.data.thumbnail && (
              <Image class="project-img" src={project.data.thumbnail} alt="" />
            )} */}
          <h2>{project.data.title}</h2>
          <p>{project.data.projectType}</p>
        </div>
      </div>
    ))
  }
</div>

<style>
  .projectContain{
    height: 400px;
    display: flex;
    flex-direction: row;
    justify-content: space-evenly;

  }

  .projectCard{
    display: flex;
    background-repeat: none;
    background-size: contain;
    align-items: center;
    overflow: visible;
    /* width: 400px; */
    /* height: 250px; */
    margin: 20px;
    margin-bottom: 0px;
    background-color: rgb(255, 230, 0);
    border: 0px solid rgba(255, 187, 0);
    transition: all 0.2s;
  }

  .fullCard:hover .projectCard, .click:hover .projectCard{
    border: 10px solid rgba(255, 187, 0);
    background-size: 105.5%;
  }

  .fullCard:hover .bottomCard, .click:hover .bottomCard{
    background-color: rgba(255, 187, 0);
  }

  .fullCard{
    position: relative;
    /* border: 5px solid white; */
    width: 53vw;
    height: 33vw;
    margin-right: 40vw;
  }

  .case{
    display: inline-block;
    scroll-snap-align: center;
    width: 50vw;
    height: 30vw;
    margin-right: 40vw;
    border-radius: 20px;
    border: 10px solid #ff660050;
    border-opacity: 50;
  }

  /* .projectCard:after{
    padding: 20px;
    background-color: rgba(255, 187, 0);
    position: relative;
    top: 0px;
    width: 500px;
    height: 323.5px;
    left: 0px;
    transition: all 0.2s;
    z-index: -1;

  }
  .projectCard:hover:after{ 
    background-color: rgba(255, 187, 0);
    position: relative;
    top: -10px;
    width: 80vw;
    height: 323.5px;
    left: 490px;

  } */

  .click{
    position: absolute;
    width: 100%;
    height: 100%;
    z-index: 100;
  }

  .bottomCard{
    background-color: #ff660050;
    position: relative;
    margin-top: -102px;
    margin-left: 30px;
    margin-bottom: 50px;
    width: 30vw;
    border-bottom-left-radius: 10px;
    transition: all 0.2s;
  }

  .bottomCard h2{
    /* background-color: rgba(255, 187, 0); */
    /* width: 400px; */
    margin-left: 20px;
    margin-bottom: 20px;
    justify-content: flex-start;
    text-align: left;
  }
  .bottomCard a{ text-decoration: none; }
  .bottomCard p{
    /* background-color: rgba(255, 187, 0); */
    color: white;
    /* width: 400px; */
    padding-left: 20px;
    padding-bottom: 10px;
    margin-top: -20px;
  }

  @media(max-width: 900px){
    .projectCard{
      width: 40vw;
      height: 30vw;
    }
    .bottomCard{
      font-size: 1.5vw;
      line-height: 3.5vw;
      width: 40vw;
    }
  }

  .backgroundCard{
    background-repeat: none;
    background-position: center;
    background-size: 100%;
  }

</style>
