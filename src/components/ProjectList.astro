---
import { getImage } from "astro:assets";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

//I GIVE UP
//Import Hero Images 
// import Peter from './astro-logo-light-gradient.png';

const allProjects = await getCollection("projects");
const sortedProjects = allProjects.sort((a,b)=>{
  return a.data.order-b.data.order
});
// const processedProjects = allProjects.map(async(project)=>{

//   return {...project,imageSrc: await getImage({src: Peter, format: 'png'}) }
// })

---


<div class="projectContain">
  {
    sortedProjects.map((project) => (
      <div class="fullCard">
        <a href={`/projects/${project.id}/`} class="click"></a>
        <div class="projectCard backgroundCard case" id={`${project.data.class}`} style={`background-image: url(${project?.data?.thumbnail?.src})`}></div>
        <div class="bottomCard">
          {/* <a href={`/projects/${project.id}/`}></a> */}
            {/* conditional rendering:
            "if project.data.thumbnail exists, then create this <Image> element"
            */}
            {/* {project.data.thumbnail && (
              <Image class="project-img" src={project.data.thumbnail} alt="" />
            )} */}
          <h2>{project.data.title}</h2>
          <p>{project.data.projectType}</p>
        </div>
      </div>
    ))
  }
</div>

<style>
  .projectContain{
    height: 400px;
    display: flex;
    flex-direction: row;
    justify-content: space-evenly;

  }

  .projectCard{
    display: flex;
    background-repeat: none;
    background-size: contain;
    align-items: center;
    overflow: visible;
    /* width: 400px; */
    /* height: 250px; */
    min-width: 400px;
    min-height: 150px;
    margin: 0px;
    margin-bottom: 0px;
    background-color: var(--color-accent);
    border: 0px solid var(--color-accent);
    background-size: cover;
    transition: all 0.2s;
  }

  @keyframes locked {
  0% { scale: 100%; rotate: 0deg; }
  16.66% { scale: 95%; rotate: 2deg; }
  33.33% { scale: 95%; rotate: 0deg; }
  50% { scale: 95%; rotate: -2deg; }
  66.66% { scale: 95%; rotate: 0deg; }
  83.33% { scale: 95%; rotate: 2deg; }
  100% { scale: 100%; rotate: 0deg; }
  }

  .fullCard:hover #dshow26, .fullCard:hover #thesis{ border: 0px; animation: locked 0.2s; }

  .fullCard:hover .projectCard, .click:hover .projectCard{
    border: 10px solid var(--color-accent);
    /* background-size: 100%; */
  }

  /* .fullCard:hover .bottomCard, .click:hover .bottomCard{
    background-color: #fee27150;
  }

  .fullCard:hover .bottomCard h2, .fullCard:hover .bottomCard p, .click:hover .bottomCard h2, .click:hover .bottomCard p{
    color: var(--color-text);
  } */

  .fullCard{
    position: relative;
    /* border: 5px solid white; */
    width: 53vw;
    height: 33vw;
    margin-right: 40vw;
  }

  .case{
    display: inline-block;
    scroll-snap-align: center;
    width: 50vw;
    height: 30vw;
    margin-right: 40vw;
    border-radius: 20px;
  }

  .click{
    position: absolute;
    width: 100%;
    height: 100%;
    z-index: 100;
  }

  .bottomCard{
    background-color: var(--color-background);
    position: relative;
    bottom: 11vw;
    left: 1vw;
    margin-bottom: 60px;
    width: fit-content;
    padding-right: 20px;
    padding-top: 5px;
    border-radius: 10px;
    transition: all 0.2s;
  }

  .bottomCard h2{
    color: var(--color-accent);
    /* width: 400px; */
    margin-left: 20px;
    margin-bottom: 20px;
    justify-content: flex-start;
    text-align: left;
  }
  .bottomCard a{ text-decoration: none; }
  .bottomCard p{
    /* background-color: rgba(255, 187, 0); */
    color: var(--color-accent);
    /* width: 400px; */
    padding-left: 20px;
    padding-bottom: 10px;
    margin-top: -20px;
  }

  @media(max-width: 900px){
    /*.projectCard{
      width: 40vw;
      height: 30vw;
    }
    .bottomCard{
      font-size: 1.5vw;
      line-height: 3.5vw;
      width: 40vw;
    }*/
  }

  .backgroundCard{
    background-repeat: none;
    background-position: center;
    background-size: 100%;
  }

  @media (max-width: 1100px){
    .bottomCard h2{
      font-size: 2.5vw;
    } .bottomCard p{
      font-size: 1.5vw;
    }
  }

  @media (max-width: 530px){
    .projectCard{
      width: 330px;
      height: 206.25px;
      min-width: 0px;
      min-height: 0px;
    }
    .fullCard{
      margin-right: 60vw;
    }
    .bottomCard{
      left: 10px;
      bottom: 75px;
    } .bottomCard h2{ font-size: 12pt; text-wrap: nowrap; } .bottomCard p{ font-size: 10pt; text-wrap: nowrap; }
  }
</style>
