---
import Container from "@components/Container.astro";
import Layout from "@layouts/Layout.astro";
import TyLogo from "@assets/images/tyAbout.JPG";
import TyHeader from "@assets/images/tyHeader.gif";
import TyDraw from "@assets/images/tyLogo.png";
import AWC from "@assets/images/AWClogoBW.png";
import CHV from "@assets/images/CHVlogoBW.png";
import NewPaltz from "@assets/images/NPlogoBW.png";
import Red from "@assets/images/RedlogoBW.png";
import TyOld from "@assets/images/oldLogo.png";
import LogoT from "@assets/images/logoT.png";
import { Content as SampleMarkdown } from "@content/sample-markdown.md";
import { Image } from "astro:assets";
---

<Layout title=about>
  <nav>
    <div class="navR">
      <a class="navItm" href="/">Portfolio</a>
      <a class="navItm" href="/about">About Me</a>
      <a class="navItm" href="/contact">Contact Me!</a>
    </div>
  </nav>
    <Container>
      <h1>About Me</h1>

      <div class="about">
        <div class="aText">
          <h2>About Me!</h2>
          <p>Hi! my name is Tyler Boggi, I am a graphic designer specializing in branding and web design/development! I graduated from SUNY New Paltz with a BFA in Graphic Design. My passion for creating comes from the desire to make designs that persuade. I love to make works that grab viewers visually and get them to truly consider what is being offered or shown to them. I strive to make works that look stunning while not sacrificing on their purpose. </p>
        </div>
        <Image alt="a picture of me" src={TyLogo} width="300" class="aImg"/>
      </div>

      <div class="about2">
        <Image alt="a picture of me" src={TyLogo} width="300" class="aImg"/>
        <div class="aText">
          <h2>My Experience</h2>
          <p>I have years of experience working anywhere from one-on-one client work to a large team of fellow designers! My work includes branding and website design for busnisses, designs made for physical production, social media, and web development. I'm open to collaborating with a team any size and ready to give you or your business a brand new look! If you'd like to get in touch then head to my...</p>
          <a href="/contact">Contact me page</a>
        </div>
      </div>

      <div class="workFor">
        <Image alt="a picture of me" src={AWC} width="300" class="wImg"/>
        <Image alt="a picture of me" src={CHV} width="300" class="wImg"/>
        <Image alt="a picture of me" src={NewPaltz} width="300" class="wImg"/>
        <Image alt="a picture of me" src={Red} width="300" class="wImg"/>
      </div>

      <div class="about3">
        <div class="aText">
          <h2>My Branding & Website</h2>
          <p style="margin-bottom: 20px;">To include this here for those still interested my branding and this website were all personally made by me!</p>
          <p style="margin-bottom: 20px;">For the website I built it using HTML & CSS coding. I used Javascript to implement all of the interaction and more in depth animation like the nav bar and project carousel. All of this was done with Astro and their content collection framework in order to put it all together in a functioning website. It was then deployed using Netlify and I used Prokbun for the domain</p>
          <p>For my personal branding I've always been iterating and changing it as my own cartoony drawing style and my physical appearance changed with time. You can see this progression below.</p>
          <p>You can also see the animation I made to show the new logo/logotype!</p>
        </div>
        <Image alt="a picture of me" src={TyHeader} width="800" class="gif"/>
      </div>

      <div class="workFor">
        <Image alt="a picture of me" src={LogoT} width="900" style="padding: 20px; "/>
      </div>
    </Container>
  
</Layout>
<div class="footer">© Tyler Boggi 2026</div>
<style>

  nav{
  position: sticky;
  top: -5px;
  paint-order: stroke fill;
  border-bottom: 5px solid var(--color-focus-ring);
  background-color: var(--color-background);
  width: 100%;
  height: 8vh;
  z-index: 100;
}

.navR{
  height: 100%;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-right: 20px;
  gap: 20px;
}

.navItm{
  width: fit-content;
  display: flex;
  justify-content: space-between;
  flex-flow: row wrap;
  font-size: 30px;
  padding: 5px;
  padding-top: 12px;
  padding-bottom: 12px;
  color: var(--color-accent);
  text-decoration: none; 
}
.navItm:hover{ color: var(--color-focus-ring); }

  .content{
    padding: 30px;
  }

  h1{
    display: flex;
    justify-content: center;
    font-weight: 900;
    font-size: 60px;
    text-align: center;
    margin-top: 20px;
    margin-bottom: 40px;
    text-decoration: none;
    color: var(--color-text);
  }

  .subHead{
    display: flex;
    justify-content: center;
    margin: 20px;
    color: var(--color-text);
    font-size: 36px;
    text-align: center;
    text-decoration: underline;
    font-weight: 800;
  }

  .multiCol{
    display: flex;
    justify-content: center;
    overflow: hidden;
    gap: 20px;
    margin-top: 30px;
    margin-bottom: 30px;
  }

  .footer{
    display: flex;
    justify-content: flex-end;
    align-items: flex-end;
    font-size: 20px;
    padding: 10px;
    padding-right: 50px;
    background-color: var(--color-background);
    border-top: 5px solid var(--color-focus-ring);
    color: var(--color-accent);
    height: 60px;
  }

  .about{
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20px;
  margin-bottom: 80px;
  height: 650px;
  background-color: var(--color-accent);
  padding: 20px;
  margin-top: 0px;
  }
  .about3{
  display: flex;
  flex-flow: column;
  justify-content: center;
  align-items: center;
  gap: 20px;
  margin-bottom: 80px;
  height: fit-content;
  background-color: var(--color-accent);
  padding: 40px;
  margin-top: 0px;
  }
  .about p {color: var(--color-background); margin-bottom: 40px;} .about h2{margin-bottom: 10px; color: var(--color-background); justify-content: flex-start; }
  .about3 p {color: var(--color-background); margin-bottom: 40px; text-align: left; } .about3 h2{margin-bottom: 10px; color: var(--color-background); justify-content: flex-start; font-size: 26px; }

  .aText{
    justify-content: center;
    align-content: center;
    max-width: 580px;
  }

  .aText a{padding: 20px; color: var(--color-focus-ring); background-color: var(--color-accent); text-decoration: none;}
  .aText a:hover{padding: 20px; background-color: var(--color-background); color: var(--color-accent);}

  .aImg{
    max-width: 300px;
    height: fit-content;
    flex-shrink: 1;
  }
  
  .wImg{
    max-width: 240px;
    padding: 10px;
    height: fit-content;
    flex-shrink: 1;
  }

  .gif{
    max-width: 700px;
    padding: 20px;
    background-color: var(--color-background);
    border-radius: 50px;
    height: fit-content;
    flex-shrink: 1;
  }

  .about2{
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20px;
  margin-bottom: 0px;
  height: 500px;
  background-color: var(--color-focus-ring);
  padding: 20px;
  margin-top: 0px;
  } .about2 p {color: var(--color-accent); margin-bottom: 40px;} .about2 h2{margin-bottom: 10px; color: var(--color-accent); justify-content: flex-start; }

  .workFor{
    display: flex;
    justify-content: center;
    align-items: center;
    flex-flow: row wrap;
    margin-bottom: 80px;
    padding-bottom: 10px;
  }

  @media (max-width: 800px) {
    nav{
      height: 50px;
    }
    .navItm{
      font-size: 18px;
    }
    .gif{
      width: 80vw;
    }
    .about{
      flex-flow: column-reverse wrap;
      height: fit-content;
      padding-top: 60px;
      padding-bottom: 60px;
    }
    .about2{
      flex-flow: column wrap;
      height: fit-content;
      padding-top: 60px;
      padding-bottom: 60px;
    }
    .about h2{ justify-content: center; }
    .about2 h2{ justify-content: center; }
    .aText{
      text-align: center;
    }
    .wImg{
      max-width: 170px;
    }
  }
</style>