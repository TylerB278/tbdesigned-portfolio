---
import Container from "@components/Container.astro";
import Layout from "@layouts/Layout.astro";
import TyLogo from "@assets/images/tyAbout.JPG";
import { Content as SampleMarkdown } from "@content/sample-markdown.md";
import { Image } from "astro:assets";
---

<Layout title=about>
  <nav>
    <div class="navR">
      <a class="navItm" href="/">Portfolio</a>
      <a class="navItm">Contact Me!</a>
    </div>
  </nav>
    <Container>
      <h1>About Me</h1>

      <div class="about">
        <div class="aText">
          <h2>About Me!</h2>
          <p>Hello, my name is Tyler Boggi! I am a graphic designer specializing in branding and web design/development! I am a graduate from SUNY New Paltz with several years of professtional Design under my belt!</p>
        </div>
        <Image alt="a picture of me" src={TyLogo} width="300" class="aImg"/>
      </div>

      <div class="about2">
        <Image alt="a picture of me" src={TyLogo} width="300" class="aImg"/>
        <div class="aText">
          <h2>My Experience</h2>
          <p>Hello, my name is Tyler Boggi! I am a graphic designer specializing in branding and web design/development! I am a graduate from SUNY New Paltz with several years of professtional Design under my belt!</p>
        </div>
      </div>

    </Container>
  
</Layout>
<div class="footer">© Tyler Boggi 2026</div>
<style>

  nav{
  position: sticky;
  top: -5px;
  paint-order: stroke fill;
  border-bottom: 5px solid var(--color-focus-ring);
  background-color: var(--color-background);
  width: 100%;
  height: 8vh;
  z-index: 100;
}

.navR{
  height: 100%;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-right: 20px;
  gap: 20px;
}

.navItm{
  width: fit-content;
  display: flex;
  justify-content: space-between;
  flex-flow: row wrap;
  font-size: 30px;
  padding: 5px;
  padding-top: 12px;
  padding-bottom: 12px;
  color: var(--color-accent);
  text-decoration: none; 
}
.navItm:hover{ color: var(--color-background); background-color: var(--color-accent);}

  .content{
    padding: 30px;
  }

  h1{
    display: flex;
    justify-content: center;
    font-weight: 900;
    font-style: italic;
    font-size: 60px;
    text-align: center;
    margin-top: 20px;
    margin-bottom: 40px;
    text-decoration: underline;
    color: var(--color-text);
  }

  .subHead{
    display: flex;
    justify-content: center;
    margin: 20px;
    color: var(--color-text);
    font-size: 36px;
    text-align: center;
    text-decoration: underline;
    font-weight: 800;
  }

  .workImg{
    max-width: 80%;
    height: auto;
    margin: 0 auto;
    margin-top: 20px;
    margin-bottom: 20px;
  }

  .colImg{
    max-width: 30%;
    height: auto;
  }

  .multiCol{
    display: flex;
    justify-content: center;
    overflow: hidden;
    gap: 20px;
    margin-top: 30px;
    margin-bottom: 30px;
  }

  .footer{
    display: flex;
    justify-content: flex-end;
    align-items: flex-end;
    font-size: 20px;
    padding: 10px;
    padding-right: 50px;
    /* border-top: 10px solid rgb(176, 85, 0); */
    background-color: var(--color-focus-ring);
    color: var(--color-background);
    height: 60px;
  }

  .about{
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20px;
  margin-bottom: 80px;
  height: 500px;
  background-color: var(--color-accent);
  padding: 20px;
  margin-top: 0px;
  } .about p {color: var(--color-background); margin-bottom: 40px;} .about h2{margin-bottom: 10px; color: var(--color-background); justify-content: flex-start; }

  .aText{
    justify-content: center;
    align-content: center;
    max-width: 400px;
  }

  .aImg{
    height: 400px;
  }

  .about2{
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20px;
  margin-bottom: 80px;
  height: 500px;
  background-color: var(--color-focus-ring);
  padding: 20px;
  margin-top: 0px;
  } .about2 p {color: var(--color-accent); margin-bottom: 40px;} .about2 h2{margin-bottom: 10px; color: var(--color-accent); justify-content: flex-start; }


</style>