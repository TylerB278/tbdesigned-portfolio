---
import Container from "@components/Container.astro";
import Layout from "@layouts/Layout.astro";
import TyLogo from "@assets/images/experienceIMG.JPG";
import TyNorm from "@assets/images/tyNorm-bg.png";
import TyRoom from "@assets/images/roomPhoto.jpg";
import BobRoss from "@assets/images/bobRoss.jpg";
import TyHeader from "@assets/images/tyHeader.gif";
import TyDraw from "@assets/images/tyLogo.png";
import AWC from "@assets/images/AWClogoBW.png";
import CHV from "@assets/images/CHVlogoBW.png";
import NewPaltz from "@assets/images/NPlogoBW.png";
import Red from "@assets/images/RedlogoBW.png";
import TyOld from "@assets/images/oldLogo.png";
import LogoT from "@assets/images/logoT.png";
import { Content as SampleMarkdown } from "@content/sample-markdown.md";
import { Image } from "astro:assets";
import DiscordY from "@assets/images/discord_Y.png";
import LinkedInY from "@assets/images/linkedIn_Y.png";
import GmailY from "@assets/images/gmail-Y.png";
import ImageComponent from "@components/ImageComponent.astro";
import ImagePopout from '@components/ImagePopout.astro';
---

<Layout title="About">
  <nav>
    <div class="navR">
      <a class="navItm" href="/">Portfolio</a>
      <a class="navItm" href="/about">About</a>
      <a class="navItm" href="/contact">Contact</a>
    </div>
  </nav>
    <Container>
      

      <div class="about">
        <div class="aText">
          <h1>About Me</h1>
          <!-- <h2>About Me!</h2> -->
          <p style="font-weight: 800;">
            Hi! I'm Tyler, a graphic designer based in New York
          </p>
          <p>
            I graduated from SUNY New Paltz with a BFA in Graphic Design on May 2026.
            Since then I have been constantly striving to use my designs to make an impact
            wherever I can whether that be for individual clients or larger organizations.
            The most important thing to me though, is constantly improving and learning!
            As much as I value my current experience,
          </p>
          <p style="font-weight: 800;">
            I know there is always more to learn and grow in this field.
          </p>
          <p>
            I've done so much varied work in design from Web Design to Motion Design to E-Commerce
            and so much more yet I aim to keep expanding this skillset with every new client. I bring
            passion and life to every project I do because design is what I love. If you would like to be
            a part of my journey to be the best designer I can be, then I'd love to be a part of your own
            journey by contributing any way I can!
          </p>
        </div>
        <Image alt="a picture of me" src={TyNorm} class="aImg"/>
      </div>

      <div class="about">
        <!-- <div class="aText">
          <h2>About Me!</h2>
          <p style="font-weight: 800;">
            In my free time I...
          </p>
          <p>
            I graduated from SUNY New Paltz with a Bachelors of Fine Arts in Graphic Design on May 2026.
            My passion for creating comes from the desire to make designs that persuade.
            I love to make works that grab viewers visually and get them to truly consider what is being offered or
            shown to them. I strive to make works that look stunning while not sacrificing on their purpose.
          </p>
        </div> -->
        <div class="aText">
          <!-- <h2>About Me!</h2> -->
          <p style="font-weight: 800;">
            Some fun facts about me:
          </p>
          <ul>
            <li>I used to bowl competitively. If you see the "278" in some of my online handles, thats my high game!</li>
          </br>
            <li>I'm an avid video game lover, having played everything from old to new since I was a child. I even play certain games competitively through tounaments and circuits like SUNY League, where I hold the title for the 2026 Super Smash Brothers Ultimate League Champion</li>
          </br>
            <li>I used to and still occasionally practive Tai Chi, Yang 24 specifically. As something I did when I was young with members of my family, it is impartant to me.</li>
          </ul>
        </div>
      </div>

      <div class="about">
        <Image alt="photography of me holding a bob ross souvenier" src={BobRoss} class="aImgBig"/>
      </div> 

      <div class="about">
        <Image alt="a picture of me" src={TyRoom} class="aImg"/>
        <div class="aText">
          <p style = "font-weight: 800;">My approach & how I view design</p>
          <p>
            I have years of experience working anywhere from one-on-one client work to a large team of fellow designers!
            My work includes branding, website design, designs for physical production, social media,
            and much more. I bring to the table the tools to bring out the goals of clents. What is most important to me 
            is understanding each and everyone's mission and goal with what they want me to make.
            Hearing the passion of others brings out the passion in me to see their dreams to reality.
            I design because I believe I can bring real and impactful change to the world in a beautiful way through designing,
            and I will continue to persue this dream no matter what.
            
        </div>
      </div>

      <div class="about">
        <div class="aText">
          <p style = "font-weight: 800;">The making of my Branding & Website</p>
          <p style="margin-bottom: 20px;">
            I built this website using HTML & CSS coding from the ground up. I used Javascript to implement
            all of the interaction and more in depth animation like the nav bar.
            All of this was done with Astro and their content collection framework in order to put it all together
            into a functioning website. It was then deployed using Netlify DNS hosting using Prokbun for the domain.
          </p>
          <p>
            For my personal branding I've always been iterating and changing it as my own drawing style
            and physical appearance changed with time. You can see where I've ended up now with a bold and bright logo looking towards the future.
            Along with this I made guidelines for my brand and the animation on the homepage!
          </p>
            
        </div>
        <ImagePopout alt="Progression of my logo over 5 years!" image={LogoT} w="600px" galleryID="1" />
      </div>

      <div class="aboutContact">
        <div class="aText">
          <p>If you like my work or just want to chat...</p>
        </div>
        <a href="/contact" class="cLink">Get in Touch!</a>
        <div class="contact-links">
          <a href="mailto:tylerboggi.work@gmail.com" target="_blank" class="link"><ImageComponent image={GmailY} alt="Instagram contact" w="200px"/></a>
          <a href="https://discord.com/users/958813877934649354" target="_blank" class="link"><ImageComponent image={DiscordY} alt="Discord contact" w="200px"/></a>
          <a href="https://www.linkedin.com/in/tyler-boggi-8192202a8/" target="_blank" class="link"><ImageComponent image={LinkedInY} alt="LinkedIn contact" w="200px"/></a>
        </div>
      </div>
      

      <!-- <div class="workFor">
        <Image alt="a picture of me" src={LogoT} width="900" style="padding: 20px; "/>
      </div> -->
    </Container>
  
</Layout>
<div class="footer">© Tyler Boggi 2026</div>
<style>

  nav{
  position: sticky;
  top: 0px;
  paint-order: stroke fill;
  border-bottom: 5px solid var(--color-focus-ring);
  background-color: var(--color-background);
  width: 100%;
  height: 8vh;
  z-index: 100;
}

.navR{
  height: 100%;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-right: 20px;
  gap: 20px;
}

.navItm{
  width: fit-content;
  display: flex;
  justify-content: space-between;
  flex-flow: row wrap;
  font-size: 30px;
  padding: 5px;
  padding-top: 12px;
  padding-bottom: 12px;
  color: var(--color-accent);
  text-decoration: none; 
}
.navItm:hover{ color: var(--color-focus-ring); }

  .content{
    padding: 30px;
  }

  h1{
    display: flex;
    justify-content: center;
    font-weight: 900;
    font-size: 60px;
    text-align: center;
    margin-top: 20px;
    margin-bottom: 40px;
    text-decoration: none;
    color: var(--color-text);
  }

  h2{
    font-size: 42pt; 
    margin: 10px;
  }

  .subHead{
    display: flex;
    justify-content: center;
    margin: 20px;
    color: var(--color-text);
    font-size: 36px;
    text-align: center;
    text-decoration: underline;
    font-weight: 800;
  }

  .multiCol{
    display: flex;
    justify-content: center;
    overflow: hidden;
    gap: 20px;
    margin-top: 30px;
    margin-bottom: 30px;
  }

  .footer{
    display: flex;
    justify-content: flex-end;
    align-items: flex-end;
    font-size: 20px;
    padding: 10px;
    padding-right: 50px;
    background-color: var(--color-background);
    border-top: 5px solid var(--color-focus-ring);
    color: var(--color-accent);
    height: 60px;
  }

  .about{
  display: flex;
  width: 100%;
  justify-content: center;
  align-items: center;
  gap: 20px;
  margin-bottom: 50px;
  /* height: 700px; */
  height: fit-content;
  padding: 20px;
  margin-top: 0px;
  }

  .aboutContact{
  display: flex;
  flex-flow: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  gap: 20px;
  margin-bottom: 80px;
  height: fit-content;
  padding: 40px;
  margin-top: 50px;
  }
  .about p {color: var(--color-text); margin-bottom: 40px;} .about h2{margin-bottom: 10px; color: var(--color-text); justify-content: flex-start; }
  .about3 p {color: var(--color-background); margin-bottom: 40px; text-align: left; } .about3 h2{margin-bottom: 10px; color: var(--color-background); justify-content: flex-start; font-size: 26px; }

  .aText{
    justify-content: center;
    align-content: center;
    max-width: 500px;
    font-size: 12pt;
    color: var(--color-text);
  }

  .cLink{padding: 20px; color: var(--color-background); background-color: var(--color-accent); text-decoration: none; font-weight: 800; font-size: 48px;}
  .cLink:hover{padding: 20px; background-color: var(--color-background); color: var(--color-accent);}

  .aImg{
    width: 60%;
    max-width: 500px;
    flex-shrink: 1;
  }
  
  .aImgBig{
    width: 60%;
    flex-shrink: 1;
  }
  
  .wImg{
    max-width: 240px;
    padding: 10px;
    height: fit-content;
    flex-shrink: 1;
  }

  .gif{
    max-width: 700px;
    padding: 20px;
    background-color: var(--color-background);
    border-radius: 50px;
    height: fit-content;
    flex-shrink: 1;
  }

  .about2{
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20px;
  margin-bottom: 0px;
  height: 500px;
  background-color: var(--color-focus-ring);
  padding: 20px;
  margin-top: 0px;
  } .about2 p {color: var(--color-background); margin-bottom: 40px;} .about2 h2{margin-bottom: 10px; color: var(--color-background); justify-content: flex-start; }

  /* .workFor{
    display: flex;
    justify-content: center;
    align-items: center;
    flex-flow: row wrap;
    margin-bottom: 80px;
    padding-bottom: 10px;
  } */

  .contact-links{   
    display: flex;
    flex-flow: row nowrap;
    max-width: 400px;
    gap: 10px;
  }

  .link{
    border: 0px solid var(--color-accent);
    transition: all 0.3s;
    max-width: 80px;
    height: fit-content;
  } .link:hover{ transform: scale(105%); }

  @media (max-width: 800px) {
    nav{
      height: 50px;
    }
    .navItm{
      font-size: 18px;
    }
    .gif{
      width: 80vw;
    }
    .about{
      flex-flow: column-reverse wrap;
      height: fit-content;
      padding-top: 0px;
      padding-bottom: 0px;
    }
    .about2{
      flex-flow: column wrap;
      height: fit-content;
      padding-top: 60px;
      padding-bottom: 60px;
    }
    .about h2{ justify-content: center; }
    .about2 h2{ justify-content: center; }
    .aText{
      text-align: center;
    }
    .wImg{
      max-width: 170px;
    }
    .aImg{
      width: 100%;
      max-width: 700px;
      flex-shrink: 1;
    }
    .aImgBig{
      width: 100%;
      flex-shrink: 1;
    }
  }

  @media (max-width: 600px) {
    .aText{
      font-size: 10pt;
    }
  }
</style>