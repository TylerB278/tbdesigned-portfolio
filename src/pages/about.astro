<div class="footer">© Tyler Boggi 2026</div>
<style>

  nav{
  position: sticky;
  top: 0px;
  paint-order: stroke fill;
  border-bottom: 5px solid var(--color-focus-ring);
  background-color: var(--color-background);
  width: 100%;
  height: 8vh;
  z-index: 100;
}

.navR{
  height: 100%;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-right: 20px;
  gap: 20px;
}

.navItm{
  width: fit-content;
  display: flex;
  justify-content: space-between;
  flex-flow: row wrap;
  font-size: 30px;
  padding: 5px;
  padding-top: 12px;
  padding-bottom: 12px;
  color: var(--color-accent);
  text-decoration: none; 
}
.navItm:hover{ color: var(--color-focus-ring); }

  .content{
    padding: 30px;
  }

  h1{
    display: flex;
    justify-content: center;
    font-weight: 900;
    font-size: 60px;
    text-align: center;
    margin-top: 20px;
    margin-bottom: 40px;
    text-decoration: none;
    color: var(--color-text);
  }

  h2{
    font-size: 42pt; 
    margin: 10px;
  }

  .subHead{
    display: flex;
    justify-content: center;
    margin: 20px;
    color: var(--color-text);
    font-size: 36px;
    text-align: center;
    text-decoration: underline;
    font-weight: 800;
  }

  .multiCol{
    display: flex;
    justify-content: center;
    overflow: hidden;
    gap: 20px;
    margin-top: 30px;
    margin-bottom: 30px;
  }

  .footer{
    display: flex;
    justify-content: flex-end;
    align-items: flex-end;
    font-size: 20px;
    padding: 10px;
    padding-right: 50px;
    background-color: var(--color-background);
    border-top: 5px solid var(--color-focus-ring);
    color: var(--color-accent);
    height: 60px;
  }

  .about{
  display: flex;
  width: 100%;
  justify-content: center;
  align-items: center;
  gap: 20px;
  margin-bottom: 50px;
  /* height: 700px; */
  height: fit-content;
  padding: 20px;
  margin-top: 0px;
  }

  .aboutContact{
  display: flex;
  flex-flow: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  gap: 20px;
  margin-bottom: 80px;
  height: fit-content;
  padding: 40px;
  margin-top: 80px;
  }
  .about p {color: var(--color-text); margin-bottom: 40px;} .about h2{margin-bottom: 10px; color: var(--color-text); justify-content: flex-start; }
  .about3 p {color: var(--color-background); margin-bottom: 40px; text-align: left; } .about3 h2{margin-bottom: 10px; color: var(--color-background); justify-content: flex-start; font-size: 26px; }

  .aText{
    justify-content: center;
    align-content: center;
    width: 500px;
    flex-shrink: 0;
    color: var(--color-text);
  }

  .aboutContact a{padding: 20px; color: var(--color-background); background-color: var(--color-accent); text-decoration: none; font-weight: 800; font-size: 42px;}
  .aboutContact a:hover{padding: 20px; background-color: var(--color-background); color: var(--color-accent);}

  .aImg{
    width: 60%;
    max-width: 500px;
    flex-shrink: 1;
  }
  
  .aImgBig{
    width: 60%;
    flex-shrink: 1;
  }
  
  .wImg{
    max-width: 240px;
    padding: 10px;
    height: fit-content;
    flex-shrink: 1;
  }

  .gif{
    max-width: 700px;
    padding: 20px;
    background-color: var(--color-background);
    border-radius: 50px;
    height: fit-content;
    flex-shrink: 1;
  }

  .about2{
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20px;
  margin-bottom: 0px;
  height: 500px;
  background-color: var(--color-focus-ring);
  padding: 20px;
  margin-top: 0px;
  } .about2 p {color: var(--color-background); margin-bottom: 40px;} .about2 h2{margin-bottom: 10px; color: var(--color-background); justify-content: flex-start; }

  .workFor{
    display: flex;
    justify-content: center;
    align-items: center;
    flex-flow: row wrap;
    margin-bottom: 80px;
    padding-bottom: 10px;
  }

  @media (max-width: 800px) {
    nav{
      height: 50px;
    }
    .navItm{
      font-size: 18px;
    }
    .gif{
      width: 80vw;
    }
    .about{
      flex-flow: column-reverse wrap;
      height: fit-content;
      padding-top: 60px;
      padding-bottom: 60px;
    }
    .about2{
      flex-flow: column wrap;
      height: fit-content;
      padding-top: 60px;
      padding-bottom: 60px;
    }
    .about h2{ justify-content: center; }
    .about2 h2{ justify-content: center; }
    .aText{
      text-align: center;
    }
    .wImg{
      max-width: 170px;
    }
  }
</style>