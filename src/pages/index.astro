---
import Layout from "@layouts/Layout.astro";
import ImageComponent from "@components/ImageComponent.astro";
import Container from "@components/Container.astro";
import TyLogo from "@assets/images/tyAbout.JPG";
import { Content as SampleMarkdown } from "@content/sample-markdown.md";
import { Image } from "astro:assets";
import ProjectList from "@components/ProjectList.astro";
import ClientList from "@components/ClientList.astro";
import PersonalWork from "@components/PersonalWork.astro";
---

<Layout title="T.B.Designed">
  <div class="heroSect">
    <!-- <h1 class="title th1">Tyler Boggi</h1> -->
     <video width="1500" height="800" autoplay="autoplay" src="tyHeader.webm" class="timg" />
    <!-- <img src="/tyHeader.webm" class="timg"></img> -->
    <!-- <h2 class="title th2">Graphic Designer</h2> -->
  </div>
  <nav id="navtop">
    <div class="navR prevent-select">
      <a class="navItm" href="#top">Portfolio</a>
      <a class="navItm" href="/about">About Me</a>
      <a class="navItm" href="/contact">Contact Me!</a>
    </div>
  </nav>
  <Container>
  
  <div class="gap"></div>
  <div class="sep"></div>

  <div class="about">
    <div class="aText">
      <h2>About Me!</h2>
      <p>Hello, my name is Tyler Boggi! I am a graphic designer specializing in branding and web design/development! I am a graduate from SUNY New Paltz with several years of professtional Design under my belt! If you'd like to learn more about me check out my...</p>
      <a href="/about">About me page</a>
    </div>
    <Image alt="a picture of me" src={TyLogo} width="300" class="aImg"/>
  </div>

  <div class="sep"></div>

  <div class="gap" id="top"></div>
  <h2 class="sectH">Clients</h2>
  <ClientList />
  <!-- <div class="sep"></div> -->
  <div class="gap" id="top"></div>

  <h2 class="sectH">Projects</h2>

  <!-- Scroll Section -->
  <div id="scrollContain">
    <div class="arrowL prevent-select"> &lt </div>
    <div class="arrowR prevent-select"> &gt </div>
    <ProjectList />
  </div>

  <!-- <PersonalWork></PersonalWork> -->
    
  </Container>
  <div class="gap"></div>
</Layout>
<div class="footer">© Tyler Boggi 2026</div>

<script>
  window.addEventListener('scroll', function() {
  const navbar = document.getElementById('navtop');
  if (window.scrollY > 120) // Shows after 100px of scrolling
  { 
    navbar?.classList.add('show');
  } else {
    navbar?.classList.remove('show');
  }
});

  const arrowL = document.querySelector(".arrowL");
  const arrowR = document.querySelector(".arrowR");
  const scrollBox = document.getElementsByClassName(".scrollContain");

  const scrollL = function () {
    // alert("YOU'VE BEEN CLICKED!!");
    document.getElementById('scrollContain').scrollLeft -= ((document.getElementById('scrollContain').scrollWidth)/4);
  };

  const scrollR = function () {
    // alert("YOU'VE BEEN CLICKED!!");
    document.getElementById('scrollContain').scrollLeft += ((document.getElementById('scrollContain').scrollWidth)/4);
  };

  arrowL?.addEventListener("click", scrollL);
  arrowR?.addEventListener("click", scrollR);
  
</script>

<style>

nav{
  position: fixed;
  paint-order: stroke fill;
  border-top: 5px solid var(--color-focus-ring);
  border-bottom: 5px solid var(--color-focus-ring);
  background-color: var(--color-background);
  width: 100%;
  height: 80px;
  z-index: 1000
}

#navtop { top: -100px; transition: top 0.5s; }
#navtop.show { top: -5px; }

.navR{
  height: 100%;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-right: 20px;
  gap: 20px;
}

.navItm{
  width: fit-content;
  display: flex;
  justify-content: space-between;
  align-content: center;
  flex-flow: row wrap;
  font-size: 30px;
  padding-left: 5px;
  padding-right: 5px;
  height: 100%;
  color: var(--color-accent);
  text-decoration: none; 
}
.navItm:hover{ color: var(--color-focus-ring);}

.heroSect{
  /* position: sticky;
  top: 10%; */
  /* width: 100%; */
  background-color: black;
  height: 100vh;
  z-index: -100;
  align-content: center;
  justify-content: center;
  overflow: hidden;
}

.title{

  transform-origin: center;
  color: var(--color-accent);
  font-size: 10vw;
  font-optical-sizing: auto;
  font-weight: 400;
  text-decoration: none;
} 

.sectH{
  display: flex;
  justify-content: center;
  font-family: "Plaster", sans-serif;
  color: var(--color-text);
  font-size: 72pt;
  font-optical-sizing: auto;
  font-weight: 400;
  text-underline-offset: 10px;
}

.about{
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20px;
  height: 500px;
  background-color: var(--color-accent);
  padding: 20px;
  margin-top: 0px;
} .about p {color: var(--color-background); margin-bottom: 40px;} .about h2{margin-bottom: 10px; color: var(--color-background); justify-content: flex-start; }
.about a{padding: 20px; color: var(--color-text); background-color: var(--color-background); text-decoration: none;}
.about a:hover{padding: 20px; background-color: var(--color-focus-ring); color: var(--color-background)}

.aText{
  justify-content: center;
  align-content: center;
  max-width: 400px;
}

.aImg{
  height: 400px;
}

.pers{ font-size: 60pt; width: 600px;}

@keyframes popIn {
  from { transform: scale(0%); }
  to { transform: scale(100%); }
}
@keyframes LtR {
  from { margin-left: -60%; }
  to { margin-left: 5%; }
}
@keyframes RtL {
  from { margin-left: 120%; }
  to { margin-left: 25%; }
}

.th1{ 
  font-size: 10vw; 
  margin-left: 5%;
  margin-bottom: -30px; 
  animation: LtR 2s;
}
.th2{ 
  width: 100vw;
  z-index: -10; 
  font-size: 8vw; 
  margin-top: -30px; 
  margin-left: 15%;
  margin-right: 0px; 
  animation: RtL 2s;
  text-decoration: none;
}
.timg{ 
  z-index: 10; 
  margin: 0 auto;
  display: flex;
  animation-repeat: none;
  transform: scale(100%);
}

@media(min-width: 1150px){
  .th1{}
  .th2{}
}

.gap{height: 100px;}
.sep{width: 100%; height: 40px; border-top: 10px solid var(--color-accent); border-bottom: 10px solid var(--color-accent); margin-top: 10px; margin-bottom: 10px;}

.footer{
  display: flex;
  justify-content: flex-end;
  align-items: flex-end;
  font-size: 20px;
  padding: 10px;
  padding-right: 50px;
  background-color: var(--color-background);
  border-top: 5px solid var(--color-focus-ring);
  color: var(--color-accent);
  height: 60px;
}

/*Scroll Content*/

  .arrowL, .arrowR{
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 7vw;
    height: 40vw;
    /* background-color: var(--color-accent); */
    border: 5px solid var(--color-accent);
    color: var(--color-accent);
    border-radius: 10px;
    opacity: 35%;
    font-size: 10vw;
    z-index: 0;
  }
  
  /* Scroll Content */
  .arrowL, .arrowR{
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 7vw;
    height: 30vw;
    /* background-color: var(--color-accent); */
    border: 5px solid var(--color-accent);
    color: var(--color-accent);
    border-radius: 10px;
    opacity: 35%;
    font-size: 10vw;
    z-index: 0;
  }

  .arrowL{ left: 1.7vw; }
  .arrowR{ right: 1.7vw; }

  .arrowL:hover, .arrowR:hover{
    opacity: 100%;
  }

  #scrollContain{
    align-content: flex-start;
    margin-top: 0px;
    padding-left: 40vw;
    margin-bottom: 0px;
    white-space: nowrap;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    height: 35vw;
    /* border: 10px solid var(--color-accent); */
  }

  .prevent-select {
    -webkit-user-select: none; /* Safari */
    -ms-user-select: none; /* IE 10 and IE 11 */
    user-select: none; /* Standard syntax */
  }

  @media(max-width: 800px){
    .sectH{
      font-size: 48pt;
    }
    .about{
      flex-flow: column-reverse wrap;
      height: fit-content;
      padding-top: 60px;
      padding-bottom: 60px;
    }
    .aText{
      max-width: 500px;
      text-align: center;
    }
    .about a{
      align-self: center;
    }
    .about h2{
      justify-self: center;
    }
    nav{
      height: 50px;
    }
    .navItm{
      font-size: 18px;
    }
  }

  @media (max-width: 530px){

    #scrollContain{
      height: 250px;
      padding-left: 60vw;
    }

    .arrowL, .arrowR{ 
      border: 0px solid white;
      width: 50px;
      height: 50px;
      z-index: 1000;
      transform: translateY(191px);
    }
    .arrowL{ left: 0px; }
    .arrowR{ right: 0px; }
  }


</style>