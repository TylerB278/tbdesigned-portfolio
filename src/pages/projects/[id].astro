---
import Container from "@components/Container.astro";
import Layout from "@layouts/Layout.astro";

import { type CollectionEntry, getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("projects");
  return posts.map((project) => ({
    params: { id: project.id },
    props: project,
  }));
}

const post = Astro.props;
// This gets the main content from the markdown file and 
// turns it into an Astro component: <Content />
const { Content } = await render(post);
---

<Layout title={post.data.title}>
  <nav>
    <div class="navR">
      <a class="navItm" href="/">Portfolio</a>
      <a class="navItm" href="/about">About Me</a>
      <a class="navItm" href="/contact">Contact Me!</a>
    </div>
  </nav>
    <Container>
      <div class="contain">
        <h1>{post.data.title}</h1>
        <Content class="content" />  
      </div>
    </Container>
  
</Layout>
<div class="footer">© Tyler Boggi 2026</div>
<style>

  nav{
  position: sticky;
  top: -5px;
  paint-order: stroke fill;
  border-bottom: 5px solid var(--color-focus-ring);
  background-color: var(--color-background);
  width: 100%;
  height: 8vh;
  z-index: 100;
}

.navR{
  height: 100%;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-right: 20px;
  gap: 20px;
}

.navItm{
  width: fit-content;
  display: flex;
  justify-content: space-between;
  flex-flow: row wrap;
  font-size: 30px;
  padding: 5px;
  padding-top: 12px;
  padding-bottom: 12px;
  color: var(--color-accent);
  text-decoration: none; 
}
.navItm:hover{ color: var(--color-focus-ring); }

  .contain{
    padding: 30px;
  }

  .content{
    padding: 30px;
  }

  h1{
    display: flex;
    justify-content: center;
    font-weight: 900;
    font-size: 72px;
    line-height: 98%;
    text-align: center;
    margin-top: 20px;
    margin-bottom: 40px;
    text-decoration: none;
    color: var(--color-text);
  }

  .subHead{
    display: flex;
    justify-content: center;
    margin: 20px;
    color: var(--color-text);
    font-size: 36px;
    text-align: center;
    text-decoration: underline;
    font-weight: 800;
  }

  .workImg{
    max-width: 80%;
    height: auto;
    margin: 0 auto;
    margin-top: 20px;
    margin-bottom: 20px;
  }

  .colImg{
    max-width: 30%;
    height: auto;
  }

  p{
    margin: 0 auto;
    margin-bottom: 30px;
    text-align: center;
    max-width: 700px;
  }

  .multiCol{
    display: flex;
    justify-content: center;
    overflow: hidden;
    gap: 20px;
    margin-top: 30px;
    margin-bottom: 30px;
  }

  .footer{
    display: flex;
    justify-content: flex-end;
    align-items: flex-end;
    font-size: 20px;
    padding: 10px;
    padding-right: 50px;
    background-color: var(--color-background);
    border-top: 5px solid var(--color-focus-ring);
    color: var(--color-accent);
    height: 60px;
  }

  @media (max-width: 800px){
    h1{
      font-size: 48px;
    }
    nav{
      height: 50px;
    }
    .navItm{
      font-size: 20px;
    }
  }
</style>