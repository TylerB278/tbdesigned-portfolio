---
import Container from "@components/Container.astro";
import Layout from "@layouts/Layout.astro";
import Instagram from "@assets/images/instagram.png";
import Discord from "@assets/images/discord.png";
import LinkedIn from "@assets/images/linkedin.png";
import Twitter from "@assets/images/twitter.png";
import InstagramY from "@assets/images/instagram_Y.png";
import DiscordY from "@assets/images/discord_Y.png";
import LinkedInY from "@assets/images/linkedIn_Y.png";
import TwitterY from "@assets/images/twitter_Y.png";
import { Content as SampleMarkdown } from "@content/sample-markdown.md";
import { Image } from "astro:assets";
import ImageComponent from "@components/ImageComponent.astro";
---

<Layout title="Contact Me">
  <nav>
    <div class="navR">
      <a class="navItm" href="/">Portfolio</a>
      <a class="navItm" href="/about">About</a>
      <a class="navItm" href="/contact">Contact</a>
    </div>
  </nav>
  <Container>
    <form action="https://api.web3forms.com/submit" method="POST" class="form">
      <input type="hidden" name="access_key" value="b8a88c5d-c7c8-48fe-b9e0-feaac6584388">
      <div class="textgroup">
        <h3>Name</h3>
        <input type="text" name="name" required class="input">
      </div>
      <div class="textgroup">
        <h3>Email</h3>
        <input type="email" name="email" required class="input"> 
      </div>
      <div class="textgroup">
        <h3>Message</h3>
        <textarea name="message" required class="input"></textarea>
      </div>
      <button type="submit" class="submit">Submit</button>
    </form>
  </Container>
  <div class="contact-links">
    <a href="https://www.instagram.com/t.b.d.esigned/" target="_blank" class="link"><ImageComponent image={InstagramY} alt="Instagram contact" w="200px"/></a>
    <a href="https://www.instagram.com/t.b.d.esigned/" target="_blank" class="link"><ImageComponent image={DiscordY} alt="Discord contact" w="200px"/></a>
    <a href="https://www.linkedin.com/in/tyler-boggi-8192202a8/" target="_blank" class="link"><ImageComponent image={LinkedInY} alt="LinkedIn contact" w="200px"/></a>
    <a href="https://x.com/UniTy2780" target="_blank" class="link"><ImageComponent image={TwitterY} alt="Twitter contact" w="200px"/></a>
  </div>
</Layout>
<div class="footer">© Tyler Boggi 2026</div>

<style>
  
  .contact-links{   
    display: flex;
    max-width: 600px;
    margin: 0 auto;
    margin-top: 40px;
    margin-bottom: 40px;
    gap: 20px;
  }

  .link{
    border: 0px solid var(--color-accent);
    transition: all 0.3s;
    max-width: 250px;
  } .link:hover{ transform: scale(105%); }

  nav{
  position: sticky;
  top: -5px;
  paint-order: stroke fill;
  border-bottom: 5px solid var(--color-focus-ring);
  background-color: var(--color-background);
  width: 100%;
  height: 8vh;
  z-index: 100;
}

.navR{
  height: 100%;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-right: 20px;
  gap: 20px;
}

.navItm{
  width: fit-content;
  display: flex;
  justify-content: space-between;
  flex-flow: row wrap;
  font-size: 30px;
  padding: 5px;
  padding-top: 12px;
  padding-bottom: 12px;
  color: var(--color-accent);
  text-decoration: none; 
}
.navItm:hover{ color: var(--color-focus-ring); }

  .content{
    padding: 30px;
  }

  .footer{
    display: flex;
    justify-content: flex-end;
    align-items: flex-end;
    font-size: 20px;
    padding: 10px;
    padding-right: 50px;
    background-color: var(--color-background);
    border-top: 5px solid var(--color-focus-ring);
    color: var(--color-accent);
    height: 60px;
  }

  @media (max-width: 800px) {
    nav{
      height: 50px;
    }
    .navItm{
      font-size: 18px;
    }
  }

  .form{
    display: flex;
    align-self: center;
    gap: 20px;
    flex-flow: column;
    width: 300px;
    margin: 30px;
    color: var(--color-accent);
  }

  h3{
    font-size: 24pt;
  }

  .input{
    width: 300px;
  }

  .submit{
    background-color: var(--color-accent);
    color: var(--color-background);
    width: 300px;
    height: 50px;
    font-weight: 800;
    border: none;
  } .submit:hover{ background-color: var(--color-focus-ring); color: var(--color-accent); }

</style>