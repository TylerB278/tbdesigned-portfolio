---
import Container from "@components/Container.astro";
import Layout from "@layouts/Layout.astro";
import Instagram from "@assets/images/instagram.png";
import Discord from "@assets/images/discord.png";
import LinkedIn from "@assets/images/linkedin.png";
import Twitter from "@assets/images/twitter.png";
import { Content as SampleMarkdown } from "@content/sample-markdown.md";
import { Image } from "astro:assets";
import ImageComponent from "@components/ImageComponent.astro";
---

<Layout title="Contact Me">
  <nav>
    <div class="navR">
      <a class="navItm" href="/">Portfolio</a>
      <a class="navItm" href="/about">About Me</a>
      <a class="navItm" href="/contact">Contact Me!</a>
    </div>
  </nav>
  <div class="contact-links">
    <a href="https://www.instagram.com/t.b.d.esigned/" target="_blank" class="link"><ImageComponent image={Instagram} alt="Instagram contact" w="200px"/></a>
    <a href="https://www.instagram.com/t.b.d.esigned/" target="_blank" class="link"><ImageComponent image={Discord} alt="Discord contact" w="200px"/></a>
    <a href="https://www.linkedin.com/in/tyler-boggi-8192202a8/" target="_blank" class="link"><ImageComponent image={LinkedIn} alt="LinkedIn contact" w="200px"/></a>
    <a href="https://x.com/UniTy2780" target="_blank" class="link"><ImageComponent image={Twitter} alt="Twitter contact" w="200px"/></a>
  </div>
    <Container>
        <div class="form">
            Contact
        </div>
    </Container>
</Layout>
<div class="footer">© Tyler Boggi 2026</div>

<style>
  
  .contact-links{   
    display: grid;
    grid-template-columns: 1fr 1fr;
    max-width: 600px;
    margin: 0 auto;
    margin-top: 40px;
    margin-bottom: 40px;
  }

  .link{
    border: 0px solid var(--color-accent);
    transition: all 0.3s;
    max-width: 250px;
  } .link:hover{ transform: scale(105%); }

  nav{
  position: sticky;
  top: -5px;
  paint-order: stroke fill;
  border-bottom: 5px solid var(--color-focus-ring);
  background-color: var(--color-background);
  width: 100%;
  height: 8vh;
  z-index: 100;
}

.navR{
  height: 100%;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-right: 20px;
  gap: 20px;
}

.navItm{
  width: fit-content;
  display: flex;
  justify-content: space-between;
  flex-flow: row wrap;
  font-size: 30px;
  padding: 5px;
  padding-top: 12px;
  padding-bottom: 12px;
  color: var(--color-accent);
  text-decoration: none; 
}
.navItm:hover{ color: var(--color-focus-ring); }

  .content{
    padding: 30px;
  }

  .footer{
    display: flex;
    justify-content: flex-end;
    align-items: flex-end;
    font-size: 20px;
    padding: 10px;
    padding-right: 50px;
    background-color: var(--color-background);
    border-top: 5px solid var(--color-focus-ring);
    color: var(--color-accent);
    height: 60px;
  }

  @media (max-width: 800px) {
    nav{
      height: 50px;
    }
    .navItm{
      font-size: 20px;
    }
  }


</style>