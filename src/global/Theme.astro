---
// we can import fonts here, after installing them via Fontsource
// see https://fontsource.org/docs/installation for instructions
import "@fontsource/karla";
import cursor from "ty-cursor.svg"
---

<style is:global>
  /* We can use this style tag to set up colors, fonts, etc. */
  :root {
    --color-background: #0e091f;
    --color-text: white;
    --color-accent: #fee271;
    --color-focus-ring: #f58434;

    --font-body: "Encode Sans", sans-serif;
    --font-headings: "Plaster", sans-serif;
    font-optical-sizing: auto;
    font-weight: 400;
    font-size: 18px;

    /* These sizes are used by the Container component to set up the page container */
    /* --size-page-width: 100%; */
    --size-page-padding: 1rem;
  }
  
  @media (max-width: 800px) {
    :root {
      font-size: 14px;
    }
    h2{
      font-size: 24px;
    }
  }
  /* We can also apply these colors as a default */
  body {
    background-color: var(--color-background);
    color: var(--color-text);
    font-family: var(--font-body);
  }
  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family: var(--font-headings);
    color: var(--color-accent);
    text-decoration: none;
  }

  h2{
    display: flex;
    justify-content: center;
    font-family: var(--font-body);
    /* margin: 20px; */
    color: white;
    font-size: 32px;
    text-align: center;
    text-decoration: none;
    font-weight: 900;
  }
  /* default focus ring styles */
  *:focus-visible {
    outline: 3px solid var(--color-focus-ring);
  }

  ::-webkit-scrollbar {
      width: .4rem;
      height: 15px;
  }

  ::-webkit-scrollbar-track {
      /* box-shadow: inset 0 0 3px var(--color-accent); */
      background-color: #f5843450;
      border-radius: 0px;
  }

  ::-webkit-scrollbar-thumb {
      background: var(--color-accent);
      border-radius: 5px;
  }

  ::-moz-selection { /* Code for Firefox */
    color: var(--color-accent);
    background: var(--color-focus-ring);
  }

  ::selection {
    color: var(--color-accent);
    background: var(--color-focus-ring);
  }

</style>
